#!/usr/bin/python3 -I
"""Root-installed boundary for dedicated TRUSTED CI, never a malicious-code sandbox.
No setup is performed. Only the configured collector may call this fixed helper;
repository commands are always demoted to the existing lwrunner account first.
"""
import contextlib
import fcntl
import hashlib
import json
import os
import pathlib
import pwd
import re
import signal
import stat
import subprocess
import sys
import time

CONFIG = pathlib.Path('/etc/dark-factory/gui-executor.json')


def protected(path, owner, directory=False):
    node = path.lstat()
    if node.st_uid != owner or node.st_mode & 0o077 or not (stat.S_ISDIR(node.st_mode) if directory else stat.S_ISREG(node.st_mode)):
        raise ValueError('protected collector path has unsafe ownership or mode')
    # POSIX modes alone do not close an inherited macOS ACL.
    listing = subprocess.run(['/bin/ls', '-led', str(path)], capture_output=True, check=True, timeout=5).stdout.decode()
    if any(' deny ' not in line for line in listing.splitlines()[1:]):
        raise ValueError('protected collector path has an ACL')


def configuration(cleanup=False):
    protected(CONFIG, 0)
    raw = CONFIG.read_bytes()
    if len(raw) > 8192:
        raise ValueError('oversized GUI configuration')
    config = json.loads(raw)
    keys = {'collectorUid', 'sourceUid', 'sourceUser', 'runnerRoot', 'developer', 'xcode', 'build', 'runtime', 'deviceType', 'trustedRepositories', 'stateDirectory', 'retiredRunnerRoots', 'collectorRepository', 'runnerName'}
    if set(config) != keys or config['sourceUser'] != 'lwrunner':
        raise ValueError('invalid GUI configuration schema')
    collector, source = config['collectorUid'], config['sourceUid']
    if type(collector) is not int or type(source) is not int or min(collector, source) < 500 or collector == source:
        raise ValueError('collector and lwrunner must be distinct non-root users')
    if os.geteuid() != 0 or os.environ.get('SUDO_UID') != str(collector) or pwd.getpwnam('lwrunner').pw_uid != source:
        raise ValueError('GUI helper caller or source identity refused')
    home = pathlib.Path(pwd.getpwuid(collector).pw_dir)
    protected(home, collector, True)
    runner = pathlib.Path(config['runnerRoot'])
    if not runner.is_relative_to(home) or runner.resolve() != runner:
        raise ValueError('runner credentials must be in the private collector home')
    protected(runner, collector, True)
    for filename in ('.runner', '.credentials', '.credentials_rsaparams'):
        protected(runner / filename, collector)
    if (runner / '.runner').stat().st_size > 8192:
        raise ValueError('oversized collector registration')
    registration = json.loads((runner / '.runner').read_text())
    if (registration.get('agentName') != config['runnerName'] or not re.fullmatch(r'factory-gui-[a-z0-9-]{8,60}', config['runnerName'])
            or not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', config['collectorRepository'])
            or str(registration.get('gitHubUrl', '')).rstrip('/').lower() != ('https://github.com/' + config['collectorRepository']).lower()):
        raise ValueError('collector registration does not match the configured central runner')
    state = pathlib.Path(config['stateDirectory'])
    if not state.is_relative_to(home) or state.resolve() != state:
        raise ValueError('GUI lease must be inside the private collector home')
    protected(state, collector, True)
    for value in ('xcode', 'build', 'runtime', 'deviceType'):
        if not isinstance(config[value], str) or not re.fullmatch(r'[A-Za-z0-9_.-]{1,150}', config[value]):
            raise ValueError('invalid pinned GUI environment')
    developer = pathlib.Path(config['developer'])
    if not developer.is_absolute() or developer.resolve() != developer or developer.stat().st_uid != 0:
        raise ValueError('Xcode must be a root-owned installation')
    repos = config['trustedRepositories']
    if not isinstance(repos, list) or not repos or len(repos) > 100 or any(not isinstance(r, str) or not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', r) for r in repos):
        raise ValueError('invalid trusted repository allowlist')
    # The old runner service MUST have been relocated before this boundary is usable.
    source_home = pathlib.Path(pwd.getpwuid(source).pw_dir)
    for relative in ('.credentials', '.credentials_rsaparams', '.config/gh/hosts.yml', '.ssh/id_rsa', '.ssh/id_ed25519'):
        if not cleanup and ((source_home / relative).exists() or (source_home / relative).is_symlink()):
            raise ValueError('execution account still holds private authentication files')
    retired = config['retiredRunnerRoots']
    if not isinstance(retired, list) or not retired or len(retired) > 16:
        raise ValueError('former source runner locations must be inventoried')
    for directory in retired:
        directory = pathlib.Path(directory)
        if not directory.is_absolute() or not directory.is_relative_to(source_home) or directory.resolve() != directory:
            raise ValueError('invalid former source runner location')
        for name in ('.credentials', '.credentials_rsaparams', '.runner', '.service'):
            if not cleanup and ((directory / name).exists() or (directory / name).is_symlink()):
                raise ValueError('execution account still holds a runner registration or credential')
    groups = subprocess.run(['/usr/bin/id', '-Gn', 'lwrunner'], capture_output=True, check=True, timeout=5).stdout.decode().split()
    if not cleanup and ('admin' in groups or 'wheel' in groups):
        raise ValueError('execution account has administrative membership')
    sudo = subprocess.run(['/usr/bin/sudo', '-n', '-l', '-U', 'lwrunner'], capture_output=True, timeout=5)
    if not cleanup and sudo.returncode == 0:
        raise ValueError('execution account has sudo authority')
    config['hash'] = hashlib.sha256(raw).hexdigest()
    return config


def workspace(text, collector, allow_missing=False):
    root = pathlib.Path(text)
    if root.parent.resolve() != pathlib.Path('/private/tmp') or not re.fullmatch(r'factory-ios-[A-Za-z0-9_-]+', root.name):
        raise ValueError('GUI workspace path refused')
    try:
        node = root.lstat()
    except FileNotFoundError:
        if allow_missing:
            return root
        raise
    if not stat.S_ISDIR(node.st_mode) or node.st_uid != collector or node.st_mode & 0o022:
        raise ValueError('GUI workspace ownership refused')
    return root


def require_lease(config, root):
    state = pathlib.Path(config['stateDirectory'])
    lock = state / 'machine.lock'
    protected(lock, config['collectorUid'])
    with open(lock, 'r+b') as stream:
        try:
            fcntl.flock(stream.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            pass
        else:
            raise ValueError('source operations require the shared machine lease')
    marker = state / 'active.json'
    protected(marker, config['collectorUid'])
    if marker.stat().st_size > 1024:
        raise ValueError('invalid GUI lease journal')
    value = json.loads(marker.read_text())
    if value.get('root') is None or pathlib.Path(value['root']).resolve() != root.resolve():
        raise ValueError('GUI operation does not own the active workspace')


def source_tool(config, root, args):
    home = root / 'home' if (root / 'home').is_dir() else pathlib.Path(pwd.getpwuid(config['sourceUid']).pw_dir)
    return subprocess.run(['/bin/launchctl', 'asuser', str(config['sourceUid']), '/usr/bin/sudo', '-n', '-u', 'lwrunner',
        '/usr/bin/env', '-i', 'PATH=/usr/bin:/bin:/usr/sbin:/sbin', 'HOME=' + str(home), 'DEVELOPER_DIR=' + config['developer'],
        *args], capture_output=True, timeout=10)


def process_groups():
    output = subprocess.run(['/bin/ps', '-axo', 'pid=,pgid=,lstart='], capture_output=True, check=True, timeout=5).stdout.decode()
    rows = []
    for line in output.splitlines():
        fields = line.split()
        if len(fields) != 7 or not fields[0].isdigit() or not fields[1].isdigit():
            raise ValueError('unreadable privileged command inventory')
        rows.append((int(fields[0]), int(fields[1]), ' '.join(fields[2:])))
    return rows


@contextlib.contextmanager
def register_command(root):
    group = os.getpgrp()
    leaders = [start for pid, pgid, start in process_groups() if pid == group and pgid == group]
    if group <= 1 or len(leaders) != 1:
        raise ValueError('GUI command has no private process group')
    record = root / ('gui-command-' + str(os.getpid()) + '.json')
    fd = os.open(record, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, 'w') as output:
            json.dump({'group': group, 'start': leaders[0]}, output)
            output.flush(); os.fsync(output.fileno())
        yield
    finally:
        record.unlink(missing_ok=True)


def stop_commands(root):
    if not root.exists():
        return
    for record in root.glob('gui-command-*.json'):
        protected(record, 0)
        if record.stat().st_size > 1024:
            raise ValueError('invalid GUI command record')
        value = json.loads(record.read_text())
        if set(value) != {'group', 'start'} or type(value['group']) is not int or value['group'] <= 1:
            raise ValueError('invalid GUI command identity')
        if value['group'] == os.getpgrp():
            continue  # this cleanup operation's own registered group remains held through return
        rows = [row for row in process_groups() if row[1] == value['group']]
        if rows:
            if not any(pid == value['group'] and start == value['start'] for pid, _, start in rows):
                raise ValueError('GUI command group identity cannot be proven')
            os.killpg(value['group'], signal.SIGKILL)
            for _ in range(20):
                if not any(pgid == value['group'] for _, pgid, _ in process_groups()):
                    break
                time.sleep(0.1)
            else:
                raise ValueError('GUI command group did not end')
        record.unlink(missing_ok=True)


BASELINE_NAME = 'gui-os-agent-baseline.json'
MAX_AGENTS = 256
MAX_COMMAND = 4096
MAX_BASELINE_BYTES = 1024 * 1024
OBSERVED_AGENTS = frozenset(('/usr/sbin/distnoted agent', '/usr/libexec/lsd', '/usr/sbin/cfprefsd agent'))


def source_processes(uid):
    # comm identifies the executable separately from argv; -ww prevents ps truncating full arguments. Ambiguous/oversized
    # inventories fail closed. OS paths with whitespace cannot be proven by this format and are deliberately not exempted.
    result = subprocess.run(['/bin/ps', '-ww', '-U', str(uid), '-o', 'pid=,ppid=,comm=,args='], capture_output=True, timeout=2)
    if result.returncode == 1 and not result.stdout.strip() and not result.stderr.strip():
        return []
    if result.returncode != 0 or result.stderr.strip() or len(result.stdout) > MAX_BASELINE_BYTES:
        raise ValueError('GUI process inventory could not be read')
    rows = result.stdout.decode().splitlines()
    if len(rows) > MAX_AGENTS:
        raise ValueError('oversized GUI process inventory')
    parsed = []
    for row in rows:
        fields = row.lstrip().split(None, 3)
        if (len(fields) != 4 or not fields[0].isdigit() or not fields[1].isdigit() or int(fields[0]) <= 1
                or int(fields[1]) < 0 or not valid_agent(fields[2], fields[3])):
            raise ValueError('unreadable GUI process inventory')
        parsed.append((int(fields[1]), fields[2], fields[3]))
    return parsed


def valid_agent(executable, command):
    return (isinstance(executable, str) and isinstance(command, str) and 0 < len(command) <= MAX_COMMAND
            and executable.startswith('/') and not any(c.isspace() for c in executable)
            and not any(ord(c) < 32 or ord(c) == 127 for c in executable + command)
            and (command == executable or command.startswith(executable + ' ')))


def root_os_binary(executable):
    path = pathlib.Path(executable)
    if not (executable.startswith('/System/Library/') or executable in ('/usr/sbin/distnoted', '/usr/libexec/lsd', '/usr/sbin/cfprefsd')):
        return False
    try:
        node = path.lstat()
        return stat.S_ISREG(node.st_mode) and node.st_uid == 0 and not node.st_mode & 0o022 and path.resolve() == path
    except OSError:
        return False


def baseline_directory(config, create=False):
    state = pathlib.Path(config['stateDirectory'])
    protected(state, config['collectorUid'], True)
    directory = state / 'os-agent-baselines'
    if create:
        try:
            directory.mkdir(mode=0o700)
        except FileExistsError:
            pass
    if directory.exists() or directory.is_symlink():
        protected(directory, 0, True)
    return directory


def baseline_name(root):
    return hashlib.sha256(str(root.resolve()).encode()).hexdigest() + '.json'


def sync_baseline_directory(directory):
    fd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def write_baseline_record(record, raw):
    # Publish a fully flushed root-owned inode exclusively. A crash cannot leave partial JSON at the authority-bearing final name.
    pending = record.with_name('.' + record.name + '.' + os.urandom(16).hex() + '.pending')
    fd = os.open(pending, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as stream:
        os.fchmod(stream.fileno(), 0o600)
        stream.write(raw)
        stream.flush(); os.fsync(stream.fileno())
    protected(pending, 0)
    try:
        os.link(pending, record, follow_symlinks=False)
    except FileExistsError:
        pending.unlink()
        raise
    # Any other failure leaves a pending snapshot, never a partial final. Only fully verified pending bytes can be recovered.
    sync_baseline_directory(record.parent)
    pending.unlink()
    protected(record, 0)


def read_baseline_record(record, uid, config, root=None):
    protected(record, 0)
    fd = os.open(record, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, 'rb') as stream:
        node = os.fstat(stream.fileno())
        if node.st_uid != 0 or stat.S_IMODE(node.st_mode) != 0o600 or not stat.S_ISREG(node.st_mode):
            raise ValueError('unsafe GUI agent baseline')
        raw = stream.read(MAX_BASELINE_BYTES + 1)
    if len(raw) > MAX_BASELINE_BYTES:
        raise ValueError('oversized GUI agent baseline')
    value = json.loads(raw)
    if (not isinstance(value, dict) or set(value) != {'version', 'uid', 'root', 'configurationHash', 'agents'}
            or type(value['version']) is not int or value['version'] != 1 or type(value['uid']) is not int or value['uid'] != uid
            or not isinstance(value['root'], str) or len(value['root']) > 1024
            or not pathlib.Path(value['root']).is_absolute() or str(pathlib.Path(value['root']).resolve()) != value['root']
            or value['configurationHash'] != config['hash'] or not re.fullmatch('[0-9a-f]{64}', value['configurationHash'])
            or not isinstance(value['agents'], list) or len(value['agents']) > MAX_AGENTS):
        raise ValueError('invalid GUI agent baseline schema')
    recorded_root = pathlib.Path(value['root'])
    if root is not None and recorded_root != root.resolve():
        raise ValueError('GUI agent baseline names another workspace')
    agents = set()
    for agent in value['agents']:
        if (not isinstance(agent, dict) or set(agent) != {'executable', 'command'}
                or not valid_agent(agent['executable'], agent['command']) or not root_os_binary(agent['executable'])):
            raise ValueError('invalid GUI agent baseline entry')
        identity = (agent['executable'], agent['command'])
        if identity in agents:
            raise ValueError('duplicate GUI agent baseline entry')
        agents.add(identity)
    return recorded_root, agents


def baseline_inventory(directory):
    entries = []
    if not directory.exists():
        return entries
    for record in directory.iterdir():
        if len(entries) >= MAX_AGENTS or not re.fullmatch(r'(?:[0-9a-f]{64}\.json|\.[0-9a-f]{64}\.json\.[0-9a-f]{32}\.pending)', record.name):
            raise ValueError('oversized or unknown GUI baseline inventory')
        entries.append(record)
    return entries


def recover_pending_baseline(root, uid, config, directory):
    record = directory / baseline_name(root)
    candidates = []
    for pending in baseline_inventory(directory):
        if pending.name.startswith('.' + record.name + '.') and pending.name.endswith('.pending'):
            read_baseline_record(pending, uid, config, root)
            candidates.append(pending)
    if not candidates:
        return False
    raw = candidates[0].read_bytes()  # every candidate was already read bounded, root-private, regular and immutable
    if any(pending.read_bytes() != raw for pending in candidates[1:]):
        raise ValueError('ambiguous pending GUI baselines')
    try:
        os.link(candidates[0], record, follow_symlinks=False)
    except FileExistsError:
        read_baseline_record(record, uid, config, root)
        if record.read_bytes() != raw:
            raise ValueError('GUI baseline publication changed')
    sync_baseline_directory(directory)
    for pending in candidates:
        pending.unlink()
    return True


def sweep_baseline_records(config, directory):
    # Only the current machine-lease holder calls this (through the fixed baseline operation). A crash after rm but before
    # clearing active.json MUST retain the old copy. Reclaim it only once a later lease journals another root and the old root is gone.
    marker = pathlib.Path(config['stateDirectory']) / 'active.json'
    protected(marker, config['collectorUid'])
    if marker.stat().st_size > 1024:
        raise ValueError('invalid GUI lease journal')
    active = json.loads(marker.read_text()).get('root')
    if not isinstance(active, str) or str(pathlib.Path(active).resolve()) != active:
        raise ValueError('invalid GUI lease journal root')
    for record in baseline_inventory(directory):
        old_root, _ = read_baseline_record(record, config['sourceUid'], config)
        expected = baseline_name(old_root)
        if record.name != expected and not re.fullmatch(r'\.' + re.escape(expected) + r'\.[0-9a-f]{32}\.pending', record.name):
            raise ValueError('GUI baseline record names another workspace')
        if str(old_root) != active and not old_root.exists() and not old_root.is_symlink():
            record.unlink()


def baseline(root, uid, config):
    # Capture once under the machine lease, BEFORE source. Persist the SAME bound bytes in protected state BEFORE the workspace
    # copy: deleting the workspace cannot erase the proof a later job needs to reconcile a crashed cleanup.
    directory = baseline_directory(config, create=True)
    sweep_baseline_records(config, directory)
    durable = directory / baseline_name(root)
    local = root / BASELINE_NAME
    if not durable.exists() and not durable.is_symlink():
        recover_pending_baseline(root, uid, config, directory)
    if durable.exists() or durable.is_symlink():
        read_baseline_record(durable, uid, config, root)
        if local.exists() or local.is_symlink():
            raise FileExistsError('GUI baseline already captured')
        write_baseline_record(local, durable.read_bytes())
        return
    if local.exists() or local.is_symlink():
        raise ValueError('GUI workspace baseline lost its durable proof')
    agents = sorted({(binary, command) for parent, binary, command in source_processes(uid)
                     if parent == 1 and root_os_binary(binary)})
    value = {'version': 1, 'uid': uid, 'root': str(root.resolve()), 'configurationHash': config['hash'],
             'agents': [{'executable': binary, 'command': command} for binary, command in agents]}
    raw = json.dumps(value).encode()
    if len(raw) > MAX_BASELINE_BYTES:
        raise ValueError('oversized GUI agent baseline')
    write_baseline_record(directory / baseline_name(root), raw)
    write_baseline_record(root / BASELINE_NAME, raw)


def read_baseline(root, uid, config, required=False):
    record = root / BASELINE_NAME
    local_exists = record.exists() or record.is_symlink()
    if required or not local_exists:
        # Never capture current post-job state. Recover only the exact, fully verified pre-source pending bytes if publication
        # was interrupted. An incomplete/ambiguous pending record is unknown and stays quarantined, never silently recaptured.
        directory = baseline_directory(config)
        durable = directory / baseline_name(root)
        if not durable.exists() and not durable.is_symlink():
            recover_pending_baseline(root, uid, config, directory)
        if durable.exists() or durable.is_symlink():
            agents = read_baseline_record(durable, uid, config, root)[1]
            if local_exists and read_baseline_record(record, uid, config, root)[1] != agents:
                raise ValueError('GUI workspace and durable baselines disagree')
            return agents
        if not required:
            return set()  # no baseline ever completed: only the three exact observed agents can be exempted
        raise FileNotFoundError('GUI source execution requires durable baseline proof')
    return read_baseline_record(record, uid, config, root)[1]


def sweep(uid, root, config):
    # Dedicated trusted-CI process cleanup only: existing exact OS-agent commands can respawn under launchd. This does NOT
    # clear dormant launchd jobs, the persistent GUI account or other source-influenced state, and is not a malicious-code sandbox.
    agents = read_baseline(root, uid, config)
    for _ in range(20):
        subprocess.run(['/usr/bin/pkill', '-KILL', '-u', str(uid)], capture_output=True, timeout=2)
        remaining = [(parent, binary, command) for parent, binary, command in source_processes(uid)
                     if not (parent == 1 and root_os_binary(binary)
                             and ((binary, command) in agents or command in OBSERVED_AGENTS))]
        if not remaining:
            return
        time.sleep(0.1)
    raise ValueError('GUI cleanup could not stop source processes')


def main():
    operation = sys.argv[1]
    config = configuration(cleanup=operation in ('check', 'sweep', 'remove', 'device-delete', 'device-reconcile'))
    if operation == 'check' and len(sys.argv) == 2:
        print(json.dumps(config))
        return
    if len(sys.argv) < 3:
        raise ValueError('missing GUI workspace')
    root = workspace(sys.argv[2], config['collectorUid'], allow_missing=operation in ('remove', 'device-delete', 'device-reconcile'))
    require_lease(config, root)
    if operation == 'run' or not root.exists():
        return execute_operation(config, operation, root)
    with register_command(root):
        return execute_operation(config, operation, root)


def execute_operation(config, operation, root):
    if operation == 'baseline' and len(sys.argv) == 3:
        stop_commands(root)
        baseline(root, config['sourceUid'], config)
    elif operation == 'sweep' and len(sys.argv) == 3:
        stop_commands(root)
        sweep(config['sourceUid'], root, config)
    elif operation == 'remove' and len(sys.argv) == 3:
        stop_commands(root)
        sweep(config['sourceUid'], root, config)
        subprocess.run(['/bin/rm', '-rf', '--', str(root)], check=True, timeout=30)
        if root.exists() or root.is_symlink():
            raise ValueError('GUI workspace removal failed')
    elif operation in ('device-delete', 'device-reconcile') and len(sys.argv) == 4:
        by_name = operation == 'device-reconcile'
        pattern = 'factory-[0-9a-f]{32}' if by_name else '[0-9A-Fa-f-]{36}'
        if not re.fullmatch(pattern, sys.argv[3]):
            raise ValueError('invalid owned GUI device identity')
        stop_commands(root)
        sweep(config['sourceUid'], root, config)
        inventory = source_tool(config, root, ['/usr/bin/xcrun', 'simctl', 'list', 'devices', '-j'])
        if inventory.returncode or len(inventory.stdout) > 8 * 1024 * 1024:
            raise ValueError('GUI device inventory could not be read')
        devices = json.loads(inventory.stdout).get('devices')
        if not isinstance(devices, dict):
            raise ValueError('unknown GUI device inventory')
        matches = []
        for group in devices.values():
            if not isinstance(group, list):
                raise ValueError('unknown GUI device inventory group')
            for device in group:
                if (not isinstance(device, dict) or not isinstance(device.get('name'), str)
                        or not isinstance(device.get('udid'), str) or not re.fullmatch('[0-9A-Fa-f-]{36}', device['udid'])):
                    raise ValueError('unknown GUI device inventory entry')
                if device['name' if by_name else 'udid'] == sys.argv[3]:
                    matches.append(device['udid'])
        if len(matches) > 1:
            raise ValueError('owned GUI device identity is ambiguous')
        if matches:
            device = matches[0]
            source_tool(config, root, ['/usr/bin/xcrun', 'simctl', 'shutdown', device])
            deleted = source_tool(config, root, ['/usr/bin/xcrun', 'simctl', 'delete', device])
            if deleted.returncode:
                raise ValueError('GUI device cleanup failed')
    elif operation == 'share' and len(sys.argv) == 4:
        target = pathlib.Path(sys.argv[3])
        if target.resolve() != target or not target.is_relative_to(root) or target == root:
            raise ValueError('GUI share path refused')
        subprocess.run(['/usr/sbin/chown', '-R', str(config['sourceUid']), str(target)], check=True, timeout=30)
    elif operation == 'run' and len(sys.argv) == 4:
        read_baseline(root, config['sourceUid'], config, required=True)
        request = pathlib.Path(sys.argv[3])
        if request.parent != root or not re.fullmatch(r'command-[a-f0-9]{32}.json', request.name):
            raise ValueError('GUI command file refused')
        protected(request, config['collectorUid'])
        if request.stat().st_size > 131072:
            raise ValueError('oversized GUI command')
        payload = json.loads(request.read_text())
        if set(payload) != {'argv', 'cwd', 'environment'} or not isinstance(payload['argv'], list) or not payload['argv']:
            raise ValueError('invalid GUI command')
        cwd = pathlib.Path(payload['cwd'])
        if not cwd.resolve().is_relative_to(root.resolve()):
            raise ValueError('GUI working directory refused')
        env = payload['environment']
        if not isinstance(env, dict) or any(not isinstance(k, str) or not isinstance(v, str) or '\0' in k + v for k, v in env.items()):
            raise ValueError('invalid GUI environment')
        # No collector environment, argv credential or command/publication file
        # reaches the source. Commands may execute trusted repository code only
        # after sudo has selected the fixed existing lwrunner identity.
        binding = root / ('binding-' + request.name)
        fd = os.open(binding, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        try:
            with os.fdopen(fd, 'w') as output:
                os.fchmod(output.fileno(), 0o644)
                json.dump({'sourceUid': config['sourceUid'], 'collectorUid': config['collectorUid'], 'configurationHash': config['hash'],
                           'collectorCredentialProbe': str(pathlib.Path(config['runnerRoot']) / '.credentials')}, output)
            env = dict(env, FACTORY_GUI_TEST_BINDING=str(binding), FACTORY_GUI_CONFIGURATION_HASH=config['hash'],
                       TEST_RUNNER_FACTORY_GUI_TEST_BINDING=str(binding), TEST_RUNNER_FACTORY_GUI_CONFIGURATION_HASH=config['hash'])
            with register_command(root):
                signal.alarm(0)  # source deadline belongs to the sealed collector; its group is now journaled
                result = subprocess.run(['/bin/launchctl', 'asuser', str(config['sourceUid']),
                    '/usr/bin/sudo', '-n', '-u', 'lwrunner', '/usr/bin/env', '-i',
                    *[k + '=' + v for k, v in env.items()], *payload['argv']], cwd=cwd,
                    env={'PATH': '/usr/bin:/bin:/usr/sbin:/sbin'})
                return result.returncode
        finally:
            binding.unlink(missing_ok=True)

    else:
        raise ValueError('unknown GUI operation')


def deadline_expired(signum, frame):
    raise TimeoutError('protected GUI operation deadline')


if __name__ == '__main__':
    signal.signal(signal.SIGALRM, deadline_expired)
    signal.alarm(30)  # privileged setup/cleanup never outlives the collector's 40-second window
    try:
        sys.exit(main() or 0)
    except Exception:
        # Root/configuration errors never disclose private paths, command text,
        # environment values, credentials or repository output into evidence.
        print('factory-gui-exec: protected GUI operation refused', file=sys.stderr)
        sys.exit(70)
