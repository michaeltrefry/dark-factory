#!/bin/bash
# factory-xcodebuild — the only xcodebuild command a Dark Factory worker is allowed (Phase 5, sc-26130; E2/E3).
#
# Installed root-owned (0755) by scripts/setup-worker-user.sh at /usr/local/libexec/dark-factory/factory-xcodebuild,
# one copy for every sandbox user (it pins nothing per user: everything it names is the running user's own). An
# implementing worker of a factory with Worker:Swift=true may run exactly this path (ClaudeWorker.XcodebuildTools); raw
# xcodebuild and xcrun are denied to every worker by name.
#
#   factory-xcodebuild build|build-for-testing|test|test-without-building -scheme <name> -destination <dest> [options]
#   factory-xcodebuild -list [-project <p.xcodeproj> | -workspace <w.xcworkspace>]
#   factory-xcodebuild --gate build-for-testing|test-without-building …   (the merge gate's test runs, sc-26131: below)
#   factory-xcodebuild clean-derived-data                                (deletes this working directory's DerivedData)
#
# Options (each at most once, except the test filters):
#   -project <relative path>.xcodeproj | -workspace <relative path>.xcworkspace
#   -configuration <name>
#   -only-testing:<test id> / -skip-testing:<test id>      (test and test-without-building only; repeatable)
#   -parallel-testing-enabled NO                           (test and test-without-building only)
#   -resultBundlePath <relative path>.xcresult             (where the gate reads test results from)
#   -quiet
# The destination is this Mac — [generic/]platform=macOS[,arch=<arm64|x86_64>][,variant=<Mac Catalyst|macOS>] — or a
# simulator: [generic/]platform=<iOS|tvOS|watchOS|visionOS> Simulator[,name=…|OS=…|id=…|arch=…]. Never a device (E3).
# -list (the schemes of the project, which a worker needs to name one; it builds nothing) is the only query.
#
# Refused (exit 64), with nothing run: every other action (archive, -exportArchive, analyze, installsrc, clean, …), every
# build-setting override (NAME=value: CODE_SIGN_IDENTITY, DEVELOPMENT_TEAM, PROVISIONING_PROFILE*, OTHER_*FLAGS, a script
# phase's inputs, an output directory such as SYMROOT/OBJROOT/DSTROOT/CONFIGURATION_BUILD_DIR, …), -xcconfig, -xctestrun,
# -testPlan, -allowProvisioningUpdates and every other signing or account flag, -derivedDataPath,
# -clonedSourcePackagesDirPath, -skipPackagePluginValidation and -skipMacroValidation (this script sets them), a device
# destination, an absolute path, one with a `.` or `..` component, one that resolves (through a symbolic link) outside the
# working directory, and any argument it does not know.
#
# What it always adds: ad hoc signing and no team or provisioning profile (CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM=
# PROVISIONING_PROFILE_SPECIFIER= PROVISIONING_PROFILE=); the running user's own DerivedData, one per working directory
# (-derivedDataPath ~/Library/Developer/Xcode/DerivedData/dark-factory/<first 16 hex of the SHA-256 of `pwd -P`>, so two
# worktrees — two items, or a gate's base and head runs — never share build products) and SwiftPM checkouts
# (-clonedSourcePackagesDirPath ~/Library/Caches/dark-factory/SourcePackages); ~ from the password database, never the
# caller's HOME, so each worker slot's sandbox user builds into its own.
# --gate (the merge gate's runs, sc-26131; nothing else changes): the SwiftPM checkouts go inside that working directory's
# DerivedData (<DerivedData>/SourcePackages) instead of the shared ~/Library/Caches/dark-factory/SourcePackages, which every
# worker session of the user can edit — so a gate run compiles only packages it resolved itself.
# clean-derived-data (no other argument): deletes this working directory's DerivedData (the gate's SourcePackages with it), as
# the running user, after checking that its parent resolves inside the user's own home; a symbolic link at that path is
# removed, never followed. The gate runs it before every build of a run and again after the run: a gate worktree's path is
# the same for every run of an item (gate-<item>-base|head), so without it a worker session of the same user could plant
# build products or a build database there for the gate's next run to build on and run. Exit 0 once the directory is gone;
# anything else is a failed clean (the gate's run is then an error, never a pass). And -skipMacroValidation
# -skipPackagePluginValidation: a fresh sandbox user has trusted no Swift macro or package plugin and nobody can click
# "Trust" for it, so without them any package graph with a macro or a build-tool plugin cannot build at all.
# xcodebuild runs with a fresh environment (HOME, a fixed PATH, the user's own TMPDIR when it has one): xcodebuild reads
# environment variables as build settings, so nothing of the caller's reaches it.
#
# Residuals, accepted: this is the only xcodebuild COMMAND a worker is allowed, not a containment boundary. Build code — Run
# Script phases, package plugins and macros (run without validation, above), a dependency's build steps, as `cargo` build
# scripts and MSBuild targets are for the other stacks — runs as the sandbox user, unrestricted, and can run
# /usr/bin/xcodebuild itself with any action or setting. E3 (ad hoc signing, simulator or this Mac only) rests on the sandbox
# user holding no signing identity, keychain item or Apple account to sign or upload with; this wrapper keeps the worker's
# own command line within it.
set -eu
unset CDPATH

# The one xcodebuild this runs (Xcode's, through xcode-select). Tests replace this line in a copy, never by a variable.
xcodebuild=/usr/bin/xcodebuild

refuse() {
    echo "factory-xcodebuild: refusing $*" >&2
    exit 64
}

usage() {
    echo "factory-xcodebuild: usage: factory-xcodebuild build|build-for-testing|test|test-without-building -scheme <name> -destination <macOS or simulator> [-project <p.xcodeproj> | -workspace <w.xcworkspace>] [-configuration <name>] [-only-testing:<id>]... [-skip-testing:<id>]... [-parallel-testing-enabled NO] [-resultBundlePath <r.xcresult>] [-quiet]" >&2
    echo "factory-xcodebuild: usage: factory-xcodebuild -list [-project <p.xcodeproj> | -workspace <w.xcworkspace>]" >&2
    echo "factory-xcodebuild: usage: factory-xcodebuild --gate build-for-testing|test-without-building … (the merge gate's runs)" >&2
    echo "factory-xcodebuild: usage: factory-xcodebuild clean-derived-data" >&2
    exit 64
}

# The working directory (the worktree), as the kernel names it: every path must resolve inside it.
work_dir=$(pwd -P)

# A path relative to the working directory that stays in it: no leading /, no . or .. component, no empty one.
# The patterns live in variables: bash 3.2 reads a pattern written inline in [[ =~ ]] differently.
path_re='^[A-Za-z0-9_.][A-Za-z0-9 ._/+-]{0,255}$' # an interval above 255 is no regex to macOS (RE_DUP_MAX)
scheme_re='^[A-Za-z0-9_][A-Za-z0-9 ._+-]{0,127}$'
simulator_re='^(generic/)?platform=(iOS|tvOS|watchOS|visionOS) Simulator(,(name|OS|id|arch)=[A-Za-z0-9][A-Za-z0-9 ._()-]{0,63})*$'
mac_re='^(generic/)?platform=macOS(,arch=(arm64|x86_64))?(,variant=(Mac Catalyst|macOS))?$'
configuration_re='^[A-Za-z0-9_][A-Za-z0-9 _-]{0,63}$'
test_id_re='^[A-Za-z0-9_][A-Za-z0-9_./():-]{0,255}$'

# Lexically inside, and inside once symbolic links are resolved: the path's nearest existing ancestor (itself when it exists)
# must be the working directory or under it. A link that resolves to nothing is refused.
resolves_inside() { # resolves_inside <relative path>
    local probe=$1 resolved
    while [ ! -e "$probe" ] && [ ! -L "$probe" ]; do
        probe=$(dirname "$probe")
    done
    if [ -d "$probe" ]; then
        resolved=$(cd -P -- "$probe" && pwd -P) || return 1
    elif [ -e "$probe" ]; then
        resolved=$(cd -P -- "$(dirname "$probe")" && pwd -P) || return 1
    else
        return 1 # a dangling link
    fi
    case "$resolved/" in "$work_dir"/*) return 0 ;; *) return 1 ;; esac
}

relative_path() { # relative_path <value> <suffix>
    local value=$1 suffix=$2
    [[ $value =~ $path_re ]] || return 1
    case "$value" in *"$suffix") ;; *) return 1 ;; esac
    case "/$value/" in */../* | */./* | *//*) return 1 ;; esac
    resolves_inside "$value"
}

# Only these canonical system/tool installation destinations may receive fixed executable inputs.
# The empty prefix and roots are source constants, not environment/configuration. Tests change them in a private COPY.
executable_prefix=
trusted_executable_roots=(/bin /usr/bin /usr/local/bin /usr/local/libexec /usr/local/Cellar /usr/local/share/dotnet /opt/homebrew/bin /opt/homebrew/Cellar /opt/homebrew/libexec /opt/homebrew/Library/Homebrew /System/Cryptexes/App/usr/bin /System/Volumes/Preboot/Cryptexes/OS/usr/bin)
canonical_executable() {
    /usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin /usr/bin/perl -T -MCwd=abs_path -e 'my $p = abs_path($ARGV[0]); defined($p) or exit 1; print $p' -- "$1"
}

[ $# -ge 1 ] || usage

# The gate's runs (sc-26131): SwiftPM checkouts inside this working directory's DerivedData, not the user's shared ones.
gate=0
if [ "$1" = --gate ]; then
    gate=1
    shift
    [ $# -ge 1 ] || usage
fi

clean=0
if [ "$1" = clean-derived-data ]; then
    [ $# -eq 1 ] || refuse "clean-derived-data with arguments"
    [ "$gate" -eq 0 ] || refuse "--gate before clean-derived-data"
    clean=1
    shift
fi

action=
list=0
scheme=
destination=
container=()
configuration=
filters=()
parallel=
result_bundle=
quiet=0
test_env=()
test_keys=" "
test_bytes=0
test_count=0

while [ $# -gt 0 ]; do
    arg=$1
    case "$arg" in
        build | build-for-testing | test | test-without-building)
            [ -z "$action" ] && [ "$list" -eq 0 ] || refuse "a second action '$arg'"
            action=$arg ;;
        -list)
            [ -z "$action" ] && [ "$list" -eq 0 ] || refuse "-list beside an action"
            [ "$gate" -eq 0 ] || refuse "--gate with -list"
            list=1 ;;
        -scheme)
            [ $# -ge 2 ] || refuse "-scheme without a name"
            [ -z "$scheme" ] || refuse "a second -scheme"
            [[ $2 =~ $scheme_re ]] || refuse "the scheme name '$2'"
            scheme=$2; shift ;;
        -destination)
            [ $# -ge 2 ] || refuse "-destination without a value"
            [ -z "$destination" ] || refuse "a second -destination"
            [[ $2 =~ $simulator_re ]] || [[ $2 =~ $mac_re ]] \
                || refuse "the destination '$2' (only this Mac or a simulator: [generic/]platform=macOS[,arch=…][,variant=…] or [generic/]platform=<iOS|tvOS|watchOS|visionOS> Simulator[,name=…])"
            destination=$2; shift ;;
        -project | -workspace)
            [ $# -ge 2 ] || refuse "$arg without a path"
            [ ${#container[@]} -eq 0 ] || refuse "a second -project/-workspace"
            suffix=.xcodeproj
            [ "$arg" = -project ] || suffix=.xcworkspace
            relative_path "$2" "$suffix" || refuse "the $arg path '$2' (a relative path inside the working directory ending $suffix)"
            container=("$arg" "$2"); shift ;;
        -configuration)
            [ $# -ge 2 ] || refuse "-configuration without a name"
            [ -z "$configuration" ] || refuse "a second -configuration"
            [[ $2 =~ $configuration_re ]] || refuse "the configuration name '$2'"
            configuration=$2; shift ;;
        -only-testing:* | -skip-testing:*)
            [[ ${arg#*:} =~ $test_id_re ]] || refuse "the test identifier in '$arg'"
            filters+=("$arg") ;;
        -parallel-testing-enabled)
            [ $# -ge 2 ] || refuse "-parallel-testing-enabled without a value"
            [ -z "$parallel" ] || refuse "a second -parallel-testing-enabled"
            [ "$2" = NO ] || refuse "-parallel-testing-enabled '$2' (only NO)"
            parallel=$2; shift ;;
        -resultBundlePath)
            [ $# -ge 2 ] || refuse "-resultBundlePath without a path"
            [ -z "$result_bundle" ] || refuse "a second -resultBundlePath"
            relative_path "$2" .xcresult || refuse "the result bundle path '$2' (a relative path inside the working directory ending .xcresult)"
            result_bundle=$2; shift ;;
        --test-env)
            [ "$gate" -eq 1 ] && [ "$action" = test-without-building ] && [ $# -ge 2 ] || refuse "test_env only on --gate test-without-building"
            pair=$2; key=${pair%%=*}; value=${pair#*=}
            name_re='^[A-Za-z_][A-Za-z0-9_]{0,127}$'
            [[ $key =~ $name_re ]] && [ "$pair" != "$key" ] || refuse "test_env.$key"
            upper=$(printf %s "$key" | /usr/bin/tr '[:lower:]' '[:upper:]')
            case "$upper" in
                PATH|HOME|TMPDIR|TMP|TEMP|USER|LOGNAME|SHELL|IFS|ENV|BASH_ENV|PS4|SHELLOPTS|BASHOPTS|CDPATH|PWD|OLDPWD|ZDOTDIR|DEVELOPER_DIR|SDKROOT|XCODE_XCCONFIG_FILE|CFFIXED_USER_HOME|MSBUILDDISABLENODEREUSE|DOTNET_CLI_USE_MSBUILD_SERVER|USESHAREDCOMPILATION|DYLD_*|LD_*|ANTHROPIC_*|OPENAI_*|ROUTER_*|FACTORY_*|GITHUB_*|ACTIONS_*|RUNNER_*|TEST_RUNNER_*|BASH_FUNC_*|*TOKEN*|*SECRET*|*PASSWORD*|*PASSWD*|*CREDENTIAL*|*AUTH*|*API_KEY*|*PRIVATE_KEY*|*ACCESS_KEY*) refuse "test_env.$key" ;;
            esac
            case "$test_keys" in *" $key "*) refuse "duplicate test_env.$key" ;; esac
            test_keys="$test_keys$key "
            [ "$test_count" -lt 32 ] && [ ${#value} -le 1024 ] || refuse "test_env.$key exceeds bounds"
            test_bytes=$((test_bytes + ${#key} + ${#value}))
            [ "$test_bytes" -le 8192 ] || refuse "test_env.$key exceeds byte limit"
            case "$value" in *'__CURRENT_VALUE__'*) refuse "test_env.$key substitution" ;; esac
            literal_re='^[A-Za-z0-9 _.,:+@%=-]*$'
            executable_re='^(/usr/bin|/bin|/usr/local/bin|/opt/homebrew/bin)/[A-Za-z0-9_+.-]+$'
            workspace_re='^[A-Za-z0-9_. /-]+$'
            case "$value" in '${worktree}/'*) value="$work_dir/${value#'${worktree}/'}" ;; esac
            case "$value" in
                "$work_dir"/*)
                    rel=${value#"$work_dir"/}
                    [[ $rel =~ $workspace_re ]] || refuse "test_env.$key workspace path"
                    case "/$rel/" in */../*|*/./*|*//*) refuse "test_env.$key traversal" ;; esac
                    probe=$rel
                    while [ "$probe" != . ]; do
                        [ ! -L "$probe" ] || refuse "test_env.$key symbolic link"
                        probe=$(dirname "$probe")
                    done
                    resolves_inside "$rel" || refuse "test_env.$key outside workspace" ;;
                /*)
                    [[ $value =~ $executable_re ]] || refuse "test_env.$key executable"
                    canonical=$(canonical_executable "$executable_prefix$value") || refuse "test_env.$key executable resolution"
                    executable_trusted=0
                    for trusted in "${trusted_executable_roots[@]}"; do
                        case "$canonical" in "$trusted"/*) executable_trusted=1 ;; esac
                    done
                    [ "$executable_trusted" -eq 1 ] || refuse "test_env.$key executable outside trusted system/tool installation roots"
                    [ -f "$canonical" ] && [ -x "$canonical" ] || refuse "test_env.$key executable"
                    value=$canonical ;;
                *) [[ $value =~ $literal_re ]] || refuse "test_env.$key value" ;;
            esac
            test_env+=("TEST_RUNNER_$key=$value"); test_count=$((test_count + 1)); shift ;;
        -quiet)
            [ "$quiet" -eq 0 ] || refuse "a second -quiet"
            quiet=1 ;;
        *=*) refuse "the build setting override '${arg%%=*}=…' (signing, scripts and output locations are the factory's)" ;;
        -*) refuse "the option '$arg'" ;;
        *) refuse "the action '$arg' (only build, build-for-testing, test and test-without-building)" ;;
    esac
    shift
done

# With HOME unset, ~ is the running user's home from the password database: the sandbox user's own, whatever the caller set.
unset HOME
home=~
[ -n "$home" ] && [ ! -L "$home" ] && [ -d "$home" ] && [ -O "$home" ] \
    || { echo "factory-xcodebuild: the running user's home '$home' is not a directory it owns" >&2; exit 70; }
work_key=$(printf %s "$work_dir" | /usr/bin/shasum -a 256 | /usr/bin/cut -c1-16)
derived_data=$home/Library/Developer/Xcode/DerivedData/dark-factory/$work_key
source_packages=$home/Library/Caches/dark-factory/SourcePackages
[ "$gate" -eq 0 ] || source_packages=$derived_data/SourcePackages

if [ "$clean" -eq 1 ]; then
    # The DerivedData root must resolve inside the user's own home (no link out of it); the key itself is removed as it is —
    # rm -rf of a symbolic link removes the link, never what it names.
    root=${derived_data%/*}
    /bin/mkdir -p -- "$root" || exit 70
    real_home=$(cd -P -- "$home" && pwd -P) || exit 70
    real_root=$(cd -P -- "$root" && pwd -P) || exit 70
    case "$real_root/" in
        "$real_home"/*) ;;
        *) echo "factory-xcodebuild: refusing to clean $derived_data: $root resolves to $real_root, outside $real_home" >&2; exit 70 ;;
    esac
    /bin/rm -rf -- "$real_root/$work_key" || exit 70
    if [ -e "$real_root/$work_key" ] || [ -L "$real_root/$work_key" ]; then
        echo "factory-xcodebuild: $derived_data is still there after it was deleted" >&2
        exit 70
    fi
    exit 0
fi

env=("HOME=$home" "PATH=/usr/bin:/bin:/usr/sbin:/sbin")
if [ "$test_count" -gt 0 ]; then env+=("${test_env[@]}"); fi
tmpdir=${TMPDIR:-}
tmpdir=${tmpdir%/}
if [ -n "$tmpdir" ] && [ ! -L "$tmpdir" ] && [ -d "$tmpdir" ] && [ -O "$tmpdir" ]; then
    env+=("TMPDIR=$tmpdir")
fi

# Xcode makes what it creates in a project it opens 0777 WHATEVER THE UMASK (sc-26134; seen with Xcode 26 under umask 022 and
# 077 alike: -list or a build of a project with no project.xcworkspace makes <p>.xcodeproj/project.xcworkspace/xcshareddata/
# swiftpm/configuration, every directory drwxrwxrwx; one that already exists is left as it is). With several worker slots the
# factory refuses to push a worktree with an entry another user may write (WorktreeWriters, sc-25990), so every first build of
# an iOS project would throw its session's work away. So xcodebuild is not exec'd: once it has returned, every entry INSIDE the
# working directory that this user owns, that was born after the run began and that its group or everyone may write loses those
# write bits (chmod go-w; links are not chosen, and chmod changes only what this user owns). Nothing older is touched (an entry made writable before the run,
# by anyone, is still the push check's to refuse) and nothing of another user's (the push check refuses an entry another user
# owns, sc-26134). When the run began is a stamp file in the user's own home, one per working directory, made before xcodebuild
# starts and removed after the clean-up: a run that never got there (killed: a Bash tool's timeout, a Stop) leaves it, and the
# next run in this working directory keeps the older stamp, so its clean-up covers what the killed run made too.
# Residual, accepted: while xcodebuild runs, what it made 0777 is writable by every user who can reach it (another slot's user,
# through the work root's read entry) until this clean-up. What they CREATE there is theirs and refused at the push; a file of
# this user's that they CHANGE in that window is not seen (the push check's own residual: a file open while the session ran
# and closed again before the push).
run_xcodebuild() {
    local runs=$home/Library/Caches/dark-factory/xcodebuild-runs stamp status=0 uid
    /bin/mkdir -p -- "$runs" || exit 70
    stamp=$runs/$work_key
    if [ -L "$stamp" ] || [ ! -f "$stamp" ]; then
        { /bin/rm -f -- "$stamp" && : > "$stamp"; } || { echo "factory-xcodebuild: could not write $stamp" >&2; exit 70; }
    fi
    /usr/bin/env -i "${env[@]}" "$xcodebuild" "$@" || status=$?
    uid=$(/usr/bin/id -u)
    # Born after the stamp: the birth time, which macOS keeps. Where find cannot read one (GNU find on Linux: only this script's
    # tests run there), the inode change time — wider (an older entry changed during the run counts too), never narrower.
    born=-newerBm
    [ "$(/usr/bin/uname -s)" = Darwin ] || born=-cnewer
    if /usr/bin/find "$work_dir" "$born" "$stamp" -user "$uid" ! -type l \( -perm -020 -o -perm -002 \) -exec /bin/chmod go-w {} +; then
        /bin/rm -f -- "$stamp"
    else
        echo "factory-xcodebuild: could not take group and other write off what this build made in $work_dir; the factory will refuse to push it" >&2
        [ "$status" -ne 0 ] || status=70
    fi
    exit "$status"
}

if [ "$list" -eq 1 ]; then
    [ -z "$scheme$destination$configuration$result_bundle$parallel" ] && [ ${#filters[@]} -eq 0 ] && [ "$quiet" -eq 0 ] \
        || refuse "-list with anything but -project or -workspace"
    run_xcodebuild -list ${container[@]+"${container[@]}"} -clonedSourcePackagesDirPath "$source_packages"
fi

[ -n "$action" ] || usage
[ -n "$scheme" ] || refuse "a build without -scheme"
case "$gate:$action" in
    0:* | 1:build-for-testing | 1:test-without-building) ;;
    *) refuse "--gate with the action '$action' (only build-for-testing and test-without-building)" ;;
esac
[ -n "$destination" ] || refuse "a build without -destination"
case "$action" in
    test | test-without-building) ;;
    *)
        [ ${#filters[@]} -eq 0 ] || refuse "-only-testing/-skip-testing outside the test actions"
        [ -z "$parallel" ] || refuse "-parallel-testing-enabled outside the test actions" ;;
esac

args=("$action" ${container[@]+"${container[@]}"} -scheme "$scheme" -destination "$destination")
[ -z "$configuration" ] || args+=(-configuration "$configuration")
args+=(${filters[@]+"${filters[@]}"})
[ -z "$parallel" ] || args+=(-parallel-testing-enabled "$parallel")
[ -z "$result_bundle" ] || args+=(-resultBundlePath "$result_bundle")
[ "$quiet" -eq 0 ] || args+=(-quiet)
args+=(-derivedDataPath "$derived_data" -clonedSourcePackagesDirPath "$source_packages")
args+=(-skipMacroValidation -skipPackagePluginValidation)
args+=(CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER= PROVISIONING_PROFILE=)
run_xcodebuild "${args[@]}"
