<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Tests pass CancellationToken.None deliberately; nothing here is long-running. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../DarkFactory.AcceptanceTests/SystemOneEvaluation.cs" Link="SystemOneEvaluation.cs" />
    <Compile Include="../DarkFactory.AcceptanceTests/SystemOneEvaluationIntake.cs" Link="SystemOneEvaluationIntake.cs" />
    <None Include="../DarkFactory.AcceptanceTests/Fixtures/systemone/**" Link="Fixtures/systemone/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DarkFactory.Orchestrator/DarkFactory.Orchestrator.csproj" />
    <!-- GatewayLintTests run the gateway analyzer on seeded code and on the orchestrator's own sources. -->
    <ProjectReference Include="../../src/DarkFactory.Analyzers/DarkFactory.Analyzers.csproj" />
    <!-- Launched as a child process by CrashResumeTests; referenced so it builds and lands in this output folder. -->
    <ProjectReference Include="../DarkFactory.CrashHost/DarkFactory.CrashHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.11.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
