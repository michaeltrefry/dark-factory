<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>factory</AssemblyName>
    <RootNamespace>DarkFactory.Orchestrator</RootNamespace>
    <UserSecretsId>dark-factory-orchestrator</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <!-- Syntax trees only (no compilation, nothing run): the gate finds the xUnit tests a PR adds (sc-25382). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="GitHub/app-manifest.json" LogicalName="app-manifest.json" />
    <EmbeddedResource Include="GitHub/gate-app-manifest.json" LogicalName="gate-app-manifest.json" />
    <!-- The review panel's prompts (sealed: the factory's own repo, compiled in; never read from a target repo or disk). -->
    <EmbeddedResource Include="../../factory/prompts/*.md" LogicalName="factory/prompts/%(Filename)%(Extension)" />
    <!-- The launch helper as the repo has it: the installed one must match it (WorkerSandbox.StaleHelperReason). Only compared, never run. -->
    <EmbeddedResource Include="../../scripts/factory-worker-launch" LogicalName="factory-worker-launch" />
    <!-- The gateway lint (sc-25390): every build fails on outbound HTTP or a git push outside Gateway/ and on a model
         provider's host anywhere (in the code and in these additional files; Razor markup is one already). -->
    <ProjectReference Include="../DarkFactory.Analyzers/DarkFactory.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="GitHub/*.json;../../factory/prompts/*.md;../../scripts/*" />
    <InternalsVisibleTo Include="DarkFactory.Orchestrator.Tests" />
    <InternalsVisibleTo Include="DarkFactory.AcceptanceTests" />
  </ItemGroup>

</Project>
