@page "/"
@attribute [Authorize]
@implements IDisposable
@inject IDashboardData Data
@inject PipelineChanges Changes
@inject TimeProvider Time
@inject IntakeStatus Intake

<PageTitle>Pipeline · Dark Factory</PageTitle>

<h1>Pipeline</h1>
@if (_stale)
{
    <p class="error">Could not refresh from the ledger; showing the last known state.</p>
}
@if (Intake.FactoryError is { } factoryError)
{
    <p class="error factory-error">Factory error (@factoryError.Count @(factoryError.Count == 1 ? "poll" : "polls") in a row, last at
        @factoryError.At.ToString("u")): @factoryError.Message</p>
}
@if (Intake.ItemErrors is { Count: > 0 } itemErrors)
{
    <ul class="error item-errors">
        @foreach (var (story, error) in itemErrors.OrderBy(e => e.Key))
        {
            <li data-story="@story"><span class="id">@story</span> failed @error.Count
                @(error.Count == 1 ? "run" : "runs") in a row before its pipeline started (last at @error.At.ToString("u")): @error.Message@(error.GaveUp is { } gaveUp ? $" — {gaveUp}" : "")</li>
        }
    </ul>
}
@if (Freeze is { } freeze)
{
    <div class="controls freeze error" data-scope="@ControlScope.Freeze">
        <span>Factory frozen: <span class="freeze-trigger">@freeze.Reason</span> — <span class="freeze-detail">@freeze.Detail</span>
            (since @freeze.ChangedAt.ToString("u")). New work is deferred and running workers stop at their next tool call.
            Continue clears it; only what happens after that can freeze the factory again.</span>
        @if (freeze.Reason == "hot-file")
        {
            <span>Legacy global hot-file freeze: predates repository incident recovery. Only an explicit human Continue clears this global freeze; automatic recovery never acknowledges it.</span>
        }
        <ControlButton Action="continue" Scope="@ControlScope.Freeze" />
    </div>
}
@* What holds new work, each with what lifts it (sc-25991): one deferred run reads as it always did; several runs deferred in
   one poll, or a factory-wide control the intake loop found in effect (as of its last read: the banners above and below are the
   ledger's, current), are listed. *@
@if (Intake.Deferrals is [{ Hold: false } deferredRun])
{
    <p class="error deferred" data-deferral="@deferredRun.Id">Deferred (last at @deferredRun.At.ToString("u")): @deferredRun.Message</p>
}
else if (Intake.Deferrals is { Count: > 0 } deferrals)
{
    <ul class="error deferrals">
        @foreach (var deferral in deferrals)
        {
            <li class="@(deferral.Hold ? "hold" : "deferred")" data-deferral="@deferral.Id">Deferred (last at @deferral.At.ToString("u")): @deferral.Message</li>
        }
    </ul>
}
@if (UsagePause is { } usage)
{
    <div class="controls usage-pause" data-scope="@ControlScope.Usage">
        <span>Factory paused for usage: <span class="usage-reason">@usage.Reason</span>, resumes at
            <span class="usage-resume">@usage.ResumeAt?.ToString("u")</span>. Running workers stop at their next tool call.</span>
        <ControlButton Action="continue" Scope="@ControlScope.Usage" />
    </div>
}
<div class="controls" data-scope="@ControlScope.Factory">
    <span>Factory: <span class="control-state">@(Paused(ControlScope.Factory) ? "paused" : "running")</span></span>
    <ControlButton Action="@(Paused(ControlScope.Factory) ? "continue" : "pause")" Scope="@ControlScope.Factory" />
    <ControlButton Action="stop" Scope="@ControlScope.Factory" />
</div>
<RecoveryStatusPanel Report="@_recovery" Controls="@_controls" PageChanged="ChangeRecoveryPageAsync" />
@foreach (var repo in RepositoriesWithoutIncident)
{
    var scope = ControlScope.Repository(repo);
    <div class="controls repository-control" data-scope="@scope">
        <span>Repository @repo: @(Paused(scope) ? "human Pause" : "not paused at repository scope")</span>
        <ControlButton Action="@(Paused(scope) ? "continue" : "pause")" Scope="@scope" />
        <ControlButton Action="stop" Scope="@scope" />
    </div>
}
@foreach (var epic in Epics)
{
    @* An epic's scope carries its source (sc-25985): `epic:12` a Shortcut epic, `epic:kb-3` a Kanban epic. *@
    var epicScope = ControlScope.Epic(epic);
    <div class="controls" data-scope="@epicScope">
        <span>Epic @epic: <span class="control-state">@(Paused(epicScope) ? "paused" : "running")</span></span>
        <ControlButton Action="@(Paused(epicScope) ? "continue" : "pause")" Scope="@epicScope" />
        <ControlButton Action="stop" Scope="@epicScope" />
    </div>
}
@if (_rows is null)
{
    <p class="muted">Loading…</p>
}
else if (_rows.Count == 0)
{
    <p class="muted">No active items.</p>
}
else
{
    <table class="pipeline">
        <thead>
            <tr><th>Item</th><th>State</th><th>Run</th><th>Repo</th><th>PR</th><th>Elapsed</th><th>Cost</th><th>Sessions</th><th>Control</th></tr>
        </thead>
        <tbody>
            @* A plan's stories are listed beneath their plan item (sc-25876), not as rows of their own. *@
            @foreach (var row in _rows.Where(r => r.PlanItemId is null || !Grouped(r)))
            {
                @ItemRow(row, null, null)
                @if (row.Plan is { } plan)
                {
                    @foreach (var story in plan.Stories)
                    {
                        @if (_rows.FirstOrDefault(r => r.PlanItemId == row.Id && r.ExternalId == story.ExternalId) is { } storyRow)
                        {
                            @ItemRow(storyRow, story, row)
                        }
                        else
                        {
                            <tr @key="@($"{row.Id}/{story.ExternalId}")" class="plan-story" data-plan="@row.Id" data-story="@story.ExternalId">
                                <td><span class="plan-indent">↳</span> <span class="id">@story.ExternalId</span> @story.Title</td>
                                <td class="state">@story.Shown
                                    @if (story.Waits.Length > 0)
                                    {
                                        <span class="@(story.Failing ? "error waits" : "muted waits")">@story.Waits</span>
                                    }
                                </td>
                                <td class="muted run">—</td>
                                <td>@(story.Repo ?? row.Repo)</td>
                                <td class="muted" colspan="5">—</td>
                            </tr>
                        }
                    }
                }
            }
        </tbody>
    </table>
}
@if (_metricsStale)
{
    <p class="error metrics-error">Could not compute the metrics; showing the last known values.</p>
}
@if (_metrics is { Count: > 0 } metrics)
{
    <h2>Metrics</h2>
    <table class="metrics">
        <thead>
            <tr><th>Metric</th><th>Value</th><th>Over</th></tr>
        </thead>
        <tbody>
            @foreach (var metric in metrics)
            {
                <tr data-metric="@metric.Name">
                    <td>@metric.Name</td>
                    <td class="@(metric.Value is null ? "value muted" : "value")">@metric.Display</td>
                    <td class="muted">@metric.Note</td>
                </tr>
            }
        </tbody>
    </table>
    <p class="muted">From the ledger's executed results only; sandbox and demo items are left out.</p>
}

@code {
    /// <summary>Whether the row is a story listed beneath its plan item (active, or finished and listed for its stories): its plan's row lists it.</summary>
    private bool Grouped(PipelineRow row) =>
        _rows?.FirstOrDefault(r => r.Id == row.PlanItemId)?.Plan?.Stories.Any(s => s.ExternalId == row.ExternalId) == true;

    /// <summary>One work item's row; <paramref name="story"/> and <paramref name="planRow"/> when it is listed beneath its plan item.</summary>
    private RenderFragment ItemRow(PipelineRow row, PlanStoryView? story, PipelineRow? planRow) => __builder =>
    {
                <tr @key="row.Id" data-item="@row.Id" class="@(story is null ? null : "plan-story")" data-plan="@planRow?.Id" data-story="@story?.ExternalId">
                    <td>@if (story is not null) { <span class="plan-indent">↳</span> }
                        @* The item on its board, where the ledger holds what the link needs (sc-25985: a Kanban item's opens its board). *@
                        @if (row.Links?.Item is { } itemUrl)
                        {
                            <a class="id" href="@itemUrl" target="_blank" rel="noopener noreferrer">@row.ExternalId</a>
                        }
                        else
                        {
                            <span class="id">@row.ExternalId</span>
                        }
                        @($" {row.Title}")
                        @if (row.Links is not null && row.Epic is { } rowEpic)
                        {
                            @(" ")<span class="muted epic" data-epic="@rowEpic">epic
                                @if (row.Links.Epic is { } epicUrl)
                                {
                                    <a href="@epicUrl" target="_blank" rel="noopener noreferrer">@rowEpic</a>
                                }
                                else
                                {
                                    @rowEpic
                                }
                            </span>
                        }
                    </td>
                    <td class="state">@row.State
                        @if (row.FailedCloseout is { } closeout)
                        {
                            <span class="error closeout-failed">closeout not posted (attempt @closeout.Attempts of @RunPipeline.MaxCloseoutAttempts;
                                @(row.CloseoutRetrying ? "retried on the next poll" : "not retried again: post it by hand")): @closeout.LastFailure</span>
                        }
                        @if (story is { Waits.Length: > 0 })
                        {
                            <span class="@(story.Failing ? "error waits" : "muted waits")">@story.Waits</span>
                        }
                        @if (row.Plan is { } plan)
                        {
                            <span class="plan-counts">@plan.Merged of @plan.Stories.Count merged · @plan.InFlight in flight · @plan.Waiting waiting · @plan.Failed failed</span>
                            @if (row.Control == ControlState.Stopping)
                            {
                                <span class="error plan-flag">stopping</span>
                            }
                            @if (plan.Stuck)
                            {
                                <span class="error plan-flag">stuck</span>
                            }
                            else if (plan.Held)
                            {
                                <span class="error plan-flag">held</span>
                            }
                            @* A plan of several repositories (sc-25873): where each repository's changeset stands, in merge order. *@
                            @foreach (var changeset in plan.Changesets ?? [])
                            {
                                <span class="@(changeset.Delivered ? "muted plan-changeset" : "plan-changeset")" data-repo="@changeset.Changeset.Repo">changeset of @changeset.Changeset.Repo: @changeset.Describe</span>
                            }
                            @if (plan.Hold is { } hold)
                            {
                                <span class="error plan-hold">@hold</span>
                            }
                            @if (plan.FailedNotices > 0)
                            {
                                <span class="error plan-notice">hold comment not posted (attempt @plan.FailedNotices of @RunPipeline.MaxPlanNoticeAttempts;
                                    @(plan.NoticeRetrying ? "tried again on the next poll" : "not tried again: this page and the ledger have it"))</span>
                            }
                            @if (plan.LastHeld is { } lastHeld)
                            {
                                <span class="muted plan-last-held">last hold recorded (@lastHeld.At.ToString("u")): @lastHeld.Detail</span>
                            }
                        }
                    </td>
                    @* Every run in flight, of this process or another (sc-25991), from the ledger: whether one is alive (the item's
                       run lock), its phase, and its worker slot — held, waited for, or only the item's. *@
                    <td class="run" data-live="@(row.Run?.Live is { } alive ? (alive ? "true" : "false") : null)">
                        @if (row.Run is { } run && !row.Finished)
                        {
                            @if (run.Live is { } live)
                            {
                                <span class="@(live ? "run-live" : "muted run-live")">@(live ? "running" : "no run now")</span>@(": ")
                            }
                            <span class="phase">@run.Phase</span>
                            @if (run.SlotText is { Length: > 0 } slotText)
                            {
                                @(" · ")<span class="@(run.Stale ? "error slot" : run.Holds || run.Waits ? "slot" : "muted slot")"
                                    data-slot="@(run.Holds ? "held" : run.Waits ? "waiting" : run.Stale ? "stale" : "idle")">@slotText</span>
                            }
                        }
                        else
                        {
                            <span class="muted">—</span>
                        }
                    </td>
                    <td>@row.Repo</td>
                    <td class="pr">
                        @if (row.PullRequestUrl is { } pr)
                        {
                            <a href="@pr" target="_blank" rel="noopener noreferrer">PR</a>
                        }
                        else
                        {
                            <span class="muted">—</span>
                        }
                    </td>
                    <td class="elapsed">@Format.Elapsed(Time.GetUtcNow() - row.CreatedAt)</td>
                    <td class="cost">@Format.ItemCost(row.CostUsd, row.Sessions)</td>
                    <td class="sessions">
                        @foreach (var s in row.Sessions.Where(s => s.ClaudeSessionId is not null))
                        {
                            var quiet = s.QuietAt(Time.GetUtcNow(), Data.QuietThreshold);
                            <a href="sessions/@Uri.EscapeDataString(s.ClaudeSessionId!)" class="@(quiet ? "quiet" : null)"
                               title="@(quiet ? $"no event for {Format.Elapsed(Time.GetUtcNow() - (s.LastEventAt ?? s.StartedAt))}" : null)">#@s.Attempt@(s.Running ? (quiet ? " (live, quiet)" : " (live)") : "")</a>
                        }
                    </td>
                    <td class="control">
                        @if (row.Control != ControlState.Running)
                        {
                            <span class="control-state">@(row.Control == ControlState.Stopping ? "stopping" : "paused")</span>
                        }
                        @if (row.Control != ControlState.Stopping && !row.Finished)
                        {
                            var scope = ControlScope.Item(row.ExternalId);
                            <ControlButton Action="@(Paused(scope) ? "continue" : "pause")" Scope="@scope" />
                            <ControlButton Action="stop" Scope="@scope" />
                        }
                    </td>
                </tr>
    };

    private readonly CancellationTokenSource _cts = new();
    private IReadOnlyList<PipelineRow>? _rows;
    private DarkFactory.Orchestrator.Recovery.RecoveryStatusReport? _recovery;
    private IEnumerable<RepoRef> RepositoriesWithoutIncident => (_rows ?? []).Select(r => RepoRef.Parse(r.Repo))
        .Concat(_controls.Keys.Select(ControlScope.RepositoryOf).OfType<RepoRef>()).DistinctBy(r => r.Key)
        .Where(r => _recovery?.Repositories.Any(i => RepoRef.Parse(i.Repo).Is(r)) != true).OrderBy(r => r.Key);
    private IReadOnlyList<Metric>? _metrics;
    private IReadOnlyDictionary<string, Control> _controls = new Dictionary<string, Control>();

    /// <summary>Whether this scope's own control (not an enclosing one) pauses it: Continue clears exactly that.</summary>
    private bool Paused(string scope) => _controls.GetValueOrDefault(scope)?.State == ControlState.Paused;

    /// <summary>The factory's freeze while it holds (until a human's Continue).</summary>
    private Control? Freeze => _controls.GetValueOrDefault(ControlScope.Freeze) is { State: not ControlState.Running } c ? c : null;

    /// <summary>The factory's usage pause while it is in effect (it lifts by itself at its resume time).</summary>
    private Control? UsagePause => _controls.GetValueOrDefault(ControlScope.Usage) is { } c && c.PausesAt(Time.GetUtcNow()) ? c : null;

    /// <summary>The epics of the listed items and of every epic control, each source's apart (Shortcut's by number first).</summary>
    private IEnumerable<EpicRef> Epics => (_rows ?? []).Select(r => r.Epic).OfType<EpicRef>()
        .Concat(_controls.Keys.Select(ControlScope.EpicOf).OfType<EpicRef>())
        .Distinct().OrderBy(e => e.Naming.Epics).ThenBy(e => e.Id);
    private ITimer? _tick;
    private bool _loading;
    private bool _again;
    private bool _stale;
    private bool _metricsStale;

    protected override async Task OnInitializedAsync()
    {
        // Subscribe before the first read, so no change between the two is missed.
        Changes.Changed += OnChanged;
        Intake.Changed += OnIntakeChanged;
        // Elapsed times move on; a running session's last event is read again (stream events are not item changes), so a
        // session that went quiet, or spoke again, shows it.
        _tick = Time.CreateTimer(_ => _ = InvokeAsync(OnTickAsync), null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
        await ReloadAsync();
    }

    private void OnChanged(long? workItemId) => _ = InvokeAsync(ReloadAsync);

    // Recovery writes need not notify work_items. Retry even after an initial failure or an empty idle read.
    private Task OnTickAsync() => ReloadAsync();

    private int _recoveryPage;
    private Task ChangeRecoveryPageAsync(int page)
    {
        _recoveryPage = page;
        return ReloadAsync();
    }

    private void OnIntakeChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Runs on the renderer: a change arriving mid-read is coalesced into one more read.</summary>
    private async Task ReloadAsync()
    {
        if (_loading)
        {
            _again = true;
            return;
        }
        _loading = true;
        try
        {
            do
            {
                _again = false;
                _rows = await Data.ActiveItemsAsync(_cts.Token);
                _recovery = await Data.RecoveryPageAsync(_recoveryPage, _cts.Token);
                _controls = (await Data.ControlsAsync(_cts.Token)).ToDictionary(c => c.Scope);
                _stale = false;
                await ReloadMetricsAsync();
            }
            while (_again);
        }
        catch (Exception) when (_cts.IsCancellationRequested)
        {
            return; // the page is gone
        }
        catch (Exception)
        {
            _stale = true;
        }
        finally
        {
            _loading = false;
        }
        StateHasChanged();
    }

    /// <summary>The metrics (computed on their own cadence, <see cref="DashboardData.MetricsAsync"/>): a failure marks only them stale.</summary>
    private async Task ReloadMetricsAsync()
    {
        try
        {
            _metrics = await Data.MetricsAsync(_cts.Token);
            _metricsStale = false;
        }
        catch (Exception) when (!_cts.IsCancellationRequested)
        {
            _metricsStale = true;
        }
    }

    public void Dispose()
    {
        Changes.Changed -= OnChanged;
        Intake.Changed -= OnIntakeChanged;
        _tick?.Dispose();
        _cts.Cancel();
    }
}
