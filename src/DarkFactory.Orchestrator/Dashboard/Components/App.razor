<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <style>
        :root { color-scheme: light dark; --muted: #888; --line: #8884; --error: #d33; --accent: #3a7bd5; }
        body { font: 14px/1.45 system-ui, sans-serif; margin: 0; }
        header { display: flex; justify-content: space-between; align-items: center; padding: .5rem 1rem; border-bottom: 1px solid var(--line); }
        header form { margin: 0; }
        .brand { font-weight: 600; text-decoration: none; color: inherit; }
        main { padding: 1rem; max-width: 1200px; }
        h1 { font-size: 1.3rem; margin: 0 0 .75rem; }
        table { border-collapse: collapse; width: 100%; }
        th, td { text-align: left; padding: .35rem .6rem; border-bottom: 1px solid var(--line); vertical-align: top; }
        .muted, .meta { color: var(--muted); }
        .id { font-family: ui-monospace, monospace; }
        .error { color: var(--error); }
        td.state { font-weight: 600; }
        td.sessions a { margin-right: .5rem; }
        .login { display: grid; gap: .6rem; max-width: 20rem; }
        .transcript { list-style: none; padding: 0; margin: 0; }
        .entry { border-left: 3px solid var(--line); padding: .25rem .6rem; margin: .4rem 0; }
        .entry .title { font-size: .8rem; color: var(--muted); }
        .entry pre { white-space: pre-wrap; word-break: break-word; margin: .2rem 0; font: 12px/1.4 ui-monospace, monospace; }
        .entry.Text pre { font: inherit; }
        .entry.Command { border-color: var(--accent); }
        .entry.Result { border-color: #2a2; }
        .entry.is-error { border-color: var(--error); }
        .entry.System, .entry.Raw { opacity: .75; }
    </style>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    @if (PageRenderMode is not null)
    {
        <script src="_framework/blazor.web.js"></script>
    }
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>The login page is static (plain form post); every other page runs on an interactive server circuit.</summary>
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.Request.Path.StartsWithSegments(DashboardAuth.LoginPath) ? null : InteractiveServer;
}
